# ---------------------------------------------------------------------------
# Every value here has a working default — copy to .env only to override.
# ---------------------------------------------------------------------------

PORT=4000
NODE_ENV=development

# Signing key for login tokens. REQUIRED in production; the server refuses to
# start without it. Generate one with:  openssl rand -hex 48
JWT_SECRET=

# Postgres connection string. Leave EMPTY for local development and the server
# runs PGlite (embedded Postgres) from server/.pgdata — no database to install.
# Set it in production, e.g. a Neon pooled connection string.
DATABASE_URL=

# Photo storage. Leave EMPTY and photos are written to server/uploads.
# On Vercel, add a Blob store and this is injected automatically.
BLOB_READ_WRITE_TOKEN=

# ---------------------------------------------------------------------------
# Google sign-in — optional. Until both are set the button is hidden and
# email/password sign-in works as normal. See README for setup steps.
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only needed if the callback URL differs from <your origin>/api/auth/google/callback
GOOGLE_REDIRECT_URI=
# Where to send people after sign-in. Defaults to the request's own origin.
APP_ORIGIN=

# Pin to your domain in production; defaults to reflecting the request origin.
CORS_ORIGIN=
