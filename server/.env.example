# ---------------------------------------------------------------------------
# Copy to .env and fill in. The first two are required — the server cannot
# run without them. Everything below them is an optional feature that hides
# itself when unset.
# ---------------------------------------------------------------------------

PORT=4000
NODE_ENV=development

# REQUIRED. Postgres connection string. There is no embedded fallback: every
# environment talks to a real database, so what runs here is what runs live.
# Free one in a minute at neon.tech — copy its "Connection string" (URI).
DATABASE_URL=

# REQUIRED. Signing key for login tokens. Generate one with:
#   openssl rand -hex 48
JWT_SECRET=

# ---------------------------------------------------------------------------
# Photo uploads — optional. Unset, the app hides the photo step and reports
# still save normally. On Vercel, connect a Blob store and this is injected.
# ---------------------------------------------------------------------------
BLOB_READ_WRITE_TOKEN=

# ---------------------------------------------------------------------------
# Email — optional. Both needed before anything is sent. See docs/9.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
MAIL_FROM=
# Used to link back to a report from the email. Optional.
APP_URL=

# ---------------------------------------------------------------------------
# Google sign-in — optional. Until both are set the button is hidden and
# email/password sign-in works as normal. See docs/6.
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only needed if the callback differs from <your origin>/api/auth/google/callback
GOOGLE_REDIRECT_URI=
# Where to send people after sign-in. Defaults to the request's own origin.
APP_ORIGIN=

# Pin to your domain in production; defaults to reflecting the request origin.
CORS_ORIGIN=
