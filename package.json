{
  "name": "campusfix",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "server",
    "client"
  ],
  "description": "CampusFix - report campus problems and track them to a fix. Express + Postgres backend, React frontend.",
  "scripts": {
    "install:all": "npm install",
    "dev": "concurrently -n server,client -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "seed": "npm run seed -w server",
    "build": "npm run build -w client",
    "start": "npm start -w server",
    "vercel-build": "npm run build -w client",
    "test": "npm test -w server",
    "check:styles": "node scripts/check-styles.mjs",
    "migrate": "npm run migrate -w server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": "24.x"
  },
  "type": "module"
}
